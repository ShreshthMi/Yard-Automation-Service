<project xmlns="http://maven.apache.org/POM/4.0.0">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.frauscher.fse</groupId>
	<artifactId>FSESimulator</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<!-- Apache POI: reads the .xlsx protocol_definition config file -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.2.5</version>
		</dependency>
		<!-- Deliberately NOT adding log4j-core here: POI pulls in log4j-api
             transitively, and it prints a harmless "could not find a logging
             implementation, using SimpleLogger" message at startup with no
             functional effect. Adding log4j-core to silence it collides with
             the older log4j-api POI bundles and throws NoClassDefFoundError
             (.../Lazy) instead. Leave it out; the message is cosmetic only. -->
	</dependencies>

	<build>
		<finalName>FSESimulator</finalName>
		<plugins>
			<!-- Package everything (our classes + POI + its dependencies) into
			one runnable jar -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>com.frauscher.fse.simulator.Main</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
